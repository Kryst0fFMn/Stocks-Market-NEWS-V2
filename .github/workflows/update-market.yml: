name: Aktualizace tržních dat

on:
  schedule:
    - cron: "17 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Načti repozitář
        uses: actions/checkout@v4

      - name: Nastav Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Nainstaluj yfinance
        run: python -m pip install yfinance

      - name: Stáhni kotace a zprávy
        run: python scripts/update_market.py

      - name: Ulož aktualizovaný JSON
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add data/market.json
          git diff --cached --quiet || git commit -m "Aktualizovat tržní data"
          git push
